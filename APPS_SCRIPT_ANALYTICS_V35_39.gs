/** Analytics Espace Parents V35.39 — remplacer le code du projet Apps Script Analytics puis METTRE À JOUR le déploiement existant. */\nconst PARENTS_STATS_SHEET='Visites Parents',PARENTS_STATS_HEADERS=['Date','Heure','Page','Langue','Appareil','Orientation','Source'],PARENTS_STATS_TZ='Europe/Paris';\nfunction doPost(e){let d={};try{d=JSON.parse(e.postData.contents)||{}}catch(x){d=(e&&e.parameter)||{}};appendVisit_(d);return out_({success:true})}\nfunction doGet(e){const p=(e&&e.parameter)||{};return out_(stats_(),p.callback)}\nfunction sheet_(){const ss=SpreadsheetApp.getActiveSpreadsheet();let s=ss.getSheetByName(PARENTS_STATS_SHEET);if(!s)s=ss.insertSheet(PARENTS_STATS_SHEET);if(!s.getLastRow())s.appendRow(PARENTS_STATS_HEADERS);let h=s.getRange(1,1,1,s.getLastColumn()).getValues()[0].map(String);if(h.indexOf('Source')<0)s.getRange(1,s.getLastColumn()+1).setValue('Source');return s}\nfunction val_(v,n){return String(v==null?'':v).trim().slice(0,n||100)}\nfunction appendVisit_(d){const s=sheet_(),n=new Date(),src=val_(d.source,30)==='enseignant_test'?'enseignant_test':'parent';s.appendRow([Utilities.formatDate(n,PARENTS_STATS_TZ,'yyyy-MM-dd'),Utilities.formatDate(n,PARENTS_STATS_TZ,'HH:mm:ss'),val_(d.page,80)||'accueil',val_(d.langue,12)||'fr',val_(d.appareil,30)||'inconnu',val_(d.orientation,20),src])}\nfunction date_(v){if(v instanceof Date)return Utilities.formatDate(v,PARENTS_STATS_TZ,'yyyy-MM-dd');const s=String(v||'').trim(),a=s.match(/^\\d{4}-\\d{2}-\\d{2}/),f=s.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/);return a?a[0]:f?f[3]+'-'+('0'+f[2]).slice(-2)+'-'+('0'+f[1]).slice(-2):''}\nfunction inc_(o,k){o[k]=(o[k]||0)+1}function pairs_(o){return Object.keys(o).map(k=>({label:k,value:o[k]})).sort((a,b)=>b.value-a.value)}function empty_(){return{today:0,week:0,pages:[],languages:[],devices:[],hours:[]}}\nfunction agg_(rows,today){const o=empty_(),p={},l={},d={},h={'00–06h':0,'06–09h':0,'09–12h':0,'12–17h':0,'17–20h':0,'20–24h':0};o.week=rows.length;rows.forEach(x=>{if(x.date===today)o.today++;inc_(p,x.page);inc_(l,x.langue);inc_(d,x.appareil);const n=parseInt(String(x.heure).slice(0,2),10);if(!isNaN(n)){if(n<6)h['00–06h']++;else if(n<9)h['06–09h']++;else if(n<12)h['09–12h']++;else if(n<17)h['12–17h']++;else if(n<20)h['17–20h']++;else h['20–24h']++}});o.pages=pairs_(p);o.languages=pairs_(l);o.devices=pairs_(d);o.hours=Object.keys(h).map(k=>({label:k,value:h[k]}));return o}\nfunction stats_(){const s=sheet_(),r=s.getLastRow(),now=new Date(),today=Utilities.formatDate(now,PARENTS_STATS_TZ,'yyyy-MM-dd'),start=Utilities.formatDate(new Date(now.getTime()-6*86400000),PARENTS_STATS_TZ,'yyyy-MM-dd');if(r<2){const e=empty_();return{success:true,updatedAt:Utilities.formatDate(now,PARENTS_STATS_TZ,'HH:mm'),parent:e,tests:e,all:e}}const data=s.getRange(1,1,r,s.getLastColumn()).getValues(),head=data.shift().map(v=>String(v).trim().toLowerCase()),i=n=>head.indexOf(n);let parent=[],tests=[],all=[];data.forEach(row=>{const dt=date_(row[i('date')]);if(!dt||dt<start||dt>today)return;const x={date:dt,heure:val_(row[i('heure')],20),page:val_(row[i('page')],80)||'accueil',langue:val_(row[i('langue')],20)||'fr',appareil:val_(row[i('appareil')],30)||'inconnu'},src=i('source')>=0&&String(row[i('source')]).trim()==='enseignant_test'?'enseignant_test':'parent';(src==='enseignant_test'?tests:parent).push(x);all.push(x)});return{success:true,updatedAt:Utilities.formatDate(now,PARENTS_STATS_TZ,'HH:mm'),parent:agg_(parent,today),tests:agg_(tests,today),all:agg_(all,today)}}\nfunction out_(o,cb){const j=JSON.stringify(o);return ContentService.createTextOutput(cb?String(cb)+'('+j+');':j).setMimeType(cb?ContentService.MimeType.JAVASCRIPT:ContentService.MimeType.JSON)}\n